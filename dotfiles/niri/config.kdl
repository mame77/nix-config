hotkey-overlay {
    skip-at-startup
}
workspace "one"
workspace "two"
gestures {
    hot-corners {
        off
    }
}
cursor {
    hide-when-typing
}
input {
    keyboard {
        xkb {
            layout "us"
            options "ctrl:nocaps"
        }
        numlock
        repeat-delay 300
        repeat-rate 30
    }
    touchpad {
        tap
        natural-scroll
        scroll-factor 0.5
    }
}
output "eDP-1" {
    mode "1920x1080@60"
    scale 1.25
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "1920x1080@60"
    position x=1536 y=0
}
layout {
    gaps 16
    default-column-width { proportion 1.0; }
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    focus-ring { width 1; active-color "#1e66f5"; }
}

// xwayland (X11 アプリ用の互換レイヤー。niri 26.04+ builtin)。
// xwayland-satellite が PATH にあると niri が自動で socket 作成 + DISPLAY 設定。
xwayland-satellite {
    path "xwayland-satellite"
}

window-rule {
    open-maximized false
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.95
}
// chromium / google-chrome は背景透過しない
window-rule {
    match app-id="chromium-browser"
    opacity 1.0
}
window-rule {
    match app-id="google-chrome"
    opacity 1.0
}
window-rule {
    match app-id="TUI.float"
    open-floating true
    opacity 0.95
}
animations {
     workspace-switch {
         spring damping-ratio=1.0 stiffness=5000 epsilon=0.0001
     }
     window-movement {
         spring damping-ratio=1.0 stiffness=5000 epsilon=0.0001
     }
     horizontal-view-movement {
         spring damping-ratio=1.0 stiffness=5000 epsilon=0.0001
     }
 }
screenshot-path "~/Images/Screenshot from %m-%d %H-%M.png"
prefer-no-csd
spawn-at-startup "sh" "-c" "/home/mame/.config/niri/scripts/battery-monitor.sh"
spawn-at-startup "fcitx5"
environment {
    DISPLAY ":0"
    XDG_SESSION_TYPE "wayland"
    QT_QPA_PLATFORM "wayland"
    GDK_BACKEND "wayland"
    MOZ_ENABLE_WAYLAND "1"
    GTK_THEME "Adwaita:dark"
    QT_STYLE_OVERRIDE "Adwaita"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    INPUT_METHOD "fcitx"
    SDL_IM_MODULE "fcitx"
}

binds {
    // app
    Mod+B     { spawn "obsidian"; }
    Mod+F     { spawn "fuzzel"; }
    Mod+V     { spawn-sh "/home/mame/.local/opt/OpenCode/ai.opencode.desktop --no-sandbox"; }
    Mod+W     { spawn "google-chrome-stable"; }
    Mod+E     { spawn "orca-desktop"; }
    Mod+R     { spawn "wlogout"; }
    Mod+T     { spawn-sh "ghostty --class='app' --command='tmux'"; }
    Mod+Shift+T     { spawn-sh "ghostty --class='app' --command='env TERM=xterm-256color ssh -tt server'"; }
    Mod+Shift+W     { spawn "chromium"; }
    // web
    Mod+G     { spawn-sh "google-chrome-stable --new-window --window-size=1504,884 --app='https://grok.com/'"; }
    Mod+S     { spawn-sh "google-chrome-stable --new-window --window-size=1504,884 --app='https://app.slack.com/client/'"; }
    Mod+D     { spawn-sh "google-chrome-stable --new-window --window-size=1504,884 --app='https://discord.com/app'"; }
    Mod+Y     { spawn-sh "google-chrome-stable --new-window --window-size=1504,884 --app='https://www.youtube.com'"; }
    // system
    Mod+Q     { close-window; }
    Mod+1     { spawn-sh "ghostty --class='TUI.float' --command='bluetuith'"; }
    Mod+2     { spawn-sh "ghostty --class='TUI.float' --command='wiremix'"; }
    Mod+3     { spawn-sh "ghostty --class='TUI.float' --command='impala'"; }
    Mod+4     { spawn-sh "ghostty --class='app'       --command='btop'"; }
    Mod+5     { spawn "sh" "-c" "wl-mirror eDP-1"; }
    // move
    Mod+H     { focus-column-left; }
    Mod+J     { focus-workspace-down; }
    Mod+K     { focus-workspace-up; }
    Mod+L     { focus-column-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+L { focus-monitor-right; }
    // move column
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+J     { move-column-to-workspace-down; }
    Mod+Ctrl+K     { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    // column size
    Mod+O         { switch-preset-column-width; }
    Mod+Shift+O   { fullscreen-window; }
    // bright
    // volume
    Mod+I         { spawn "sh" "-c" "/home/mame/.config/niri/scripts/volume.sh up"; }
    Mod+U         { spawn "sh" "-c" "/home/mame/.config/niri/scripts/volume.sh down"; }
    Mod+Shift+U   { spawn "sh" "-c" "/home/mame/.config/niri/scripts/volume.sh mute"; }
    // record
    Mod+Z { spawn "sh" "-c" "noctalia msg plugin noctalia/screen_recorder:service all toggle";}
    Mod+X { screenshot; }
    // openwhispr dictation
    Mod+C { spawn "sh" "-c" "ydotool key 125:1 42:1 193:1 && sleep 0.05 && ydotool key 125:0 42:0 193:0"; }
    // off
    Mod+Shift+E   { quit; }
}
